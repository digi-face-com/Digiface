# روی VPS: کپی کن به .env.production.local (یا .env در روت پروژه)
# cp .env.production.example .env.production.local

# MySQL روی همان VPS (localhost) یا سرور DB جدا
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/digiface_db"

# secret جدا از لوکال — حتماً مقدار جدید و قوی بگذار
NEXTAUTH_SECRET="یه رشته تصادفی طولانی اینجا بذار"

# دامنهٔ عمومی production
NEXTAUTH_URL="https://digi-face.ir"

# اختیاری — پورت Node روی VPS (PM2 / server.js)
# PORT=3000
# NODE_ENV=production
