# کپی کن به .env.local و مقادیر را پر کن
# cp .env.local.example .env.local

# دیتابیس MySQL روی سیستم خودت (XAMPP / Docker / MySQL مستقیم)
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/digiface_db"

# secret برای session/JWT — یک بار generate کن و عوض نکن
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="یه رشته تصادفی طولانی اینجا بذار"

# آدرس اپ در حالت توسعه
NEXTAUTH_URL="http://localhost:3000"
