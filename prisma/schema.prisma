// ════════════════════════════════════════════════════
// DiGiFACE — Database Schema (Prisma + MySQL)
// ════════════════════════════════════════════════════
// نکته: این schema برای MySQL (پارس‌پک) تنظیم شده
// برای اجرا: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════

enum Role {
  CUSTOMER      // کاربر عادی
  SHOP          // فروشگاه
  PICK          // پیک
  ADMIN         // کارشناس/ادمین
  SUPER_ADMIN   // مدیر اصلی
  B2B           // کاربر ویژه (فاز ۲)
  SUPPLIER      // کارخانه/پخش (فاز ۲)
}

enum UserTier {
  BRONZE    // 0-100
  SILVER    // 101-500
  GOLD      // 501-2000
  PLATINUM  // 2001+
}

enum ShopStatus {
  PENDING_REVIEW   // در انتظار بررسی کارشناس
  APPROVED         // تأیید شده
  REJECTED         // رد شده
  SUSPENDED        // معلق (تخلف)
}

enum ProductStatus {
  PENDING_AI       // در صف بررسی AI
  APPROVED         // تأیید شده
  REJECTED_AI      // رد شده توسط AI
  PENDING_ADMIN    // ارجاع به ادمین (اصرار فروشنده یا گزارش)
  OUT_OF_STOCK     // ناموجود (محو خودکار)
  ARCHIVED         // آرشیو شده
}

enum BoxStatus {
  ACTIVE
  INACTIVE
  PENDING_ADMIN_ITEM  // محصول جدید باکس منتظر تأیید ادمین
}

enum OrderStatus {
  CART_SAVED          // سبد ذخیره‌شده (پرداخت معلق)
  PENDING_SHOP        // منتظر تأیید فروشگاه
  CONFIRMED           // تأیید شده توسط فروشگاه
  PICK_SEARCHING      // در جستجوی پیک
  PICK_ASSIGNED       // پیک تخصیص یافت
  PICK_PICKED_UP      // پیک از فروشگاه تحویل گرفت
  OUT_FOR_DELIVERY    // در حال ارسال به مشتری
  DELIVERED           // تحویل به مشتری (پیک زد)
  COMPLETED           // مشتری ارزیابی کرد / تکمیل شد
  CANCELLED_BY_USER   // لغو توسط کاربر (قبل تأیید فروشگاه)
  CANCELLED_BY_SHOP   // لغو/رد توسط فروشگاه
  PARTIALLY_FULFILLED // برخی اقلام حذف شد
  RETURNED            // عودت توسط پیک
  ESCALATED_ADMIN     // ارجاع به کارشناس (تایمر گذشته)
  INTERCITY_PROCESSING // در حال پردازش خارج‌شهر (AI/ادمین)
}

enum OrderType {
  LOCAL       // همشهری
  INTERCITY   // خارج‌شهر
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE   // نیاز به خودرو ×۱.۶
}

enum DeliveryMethod {
  PICK_MOTOR     // پیک موتوری/همشهری
  PICK_CAR       // پیک خودرو (بسته بزرگ)
  POST           // پست
  CARRIER        // شرکت حمل (الوپیک، تیپاکس، ...)
  VAN            // وانتی (فاز ۲)
  INTER_SHOP     // باکس بین‌فروشگاهی
}

enum PaymentMethod {
  ONLINE        // زرین‌پال
  WALLET        // کیف پول
  CHECK         // چکی (فاز ۲ — کاربر ویژه)
}

enum TransactionType {
  DEPOSIT           // واریز
  WITHDRAWAL        // برداشت
  ORDER_PAYMENT     // پرداخت بابت سفارش
  COMMISSION        // کسر کمیسیون
  REFUND            // بازگشت وجه
  PICK_FEE          // هزینه پیک
  PICK_FEE_PENALTY  // جریمه عودت (×۱.۵)
  PICK_PAYOUT       // پرداخت به پیک
}

enum WalletOwnerType {
  CUSTOMER
  SHOP
  PICK
}

enum ReviewType {
  GREAT       // تجربه عالی
  NORMAL      // معمولی
  REPORT      // گزارش مشکل
}

enum ReportReason {
  NOT_DELIVERED      // تحویل نگرفتم
  BAD_BEHAVIOR       // رفتار ناپسند
  WRONG_ITEM
  DAMAGED
  OTHER
}

enum TicketStatus {
  ACTIVE
  RESOLVED
  ARCHIVED   // منسوخ — غیرقابل کلیک برای کاربر
}

enum TicketCategory {
  UPLOAD          // آپلود محتوا
  ORDER           // سفارش
  FINANCIAL       // مالی/تسویه
  DELIVERY        // پیک/تحویل
  TECHNICAL       // فنی
  CONTRACT        // قرارداد
  CAMPAIGN        // کمپین
  OTHER           // سایر
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum NotificationChannel {
  IN_APP
  SMS
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

// ════════════════════════════════════════════════════
// USERS & AUTH
// ════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  phoneVerified Boolean   @default(false)
  username      String?   @unique
  passwordHash  String?
  fullName      String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)

  // امتیاز کاربر (سیستم رتبه‌بندی)
  score         Int       @default(0)
  tier          UserTier  @default(BRONZE)

  // حساب منفی (در صورت عودت با موجودی ناکافی)
  negativeBalance Decimal @default(0) @db.Decimal(12,2)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // روابط
  addresses     Address[]
  orders        Order[]         @relation("CustomerOrders")
  reviews       Review[]
  wallet        Wallet?
  shop          Shop?
  pick          Pick?
  adminProfile  AdminProfile?
  tickets       Ticket[]
  notifications Notification[]
  behaviorLogs  BehaviorLog[]
  scoreHistory  ScoreHistory[]

  @@index([role])
  @@index([phone])
}

model Address {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       AddressLabel @default(HOME)
  title       String?      // عنوان دلخواه کاربر
  city        String
  fullAddress String       @db.Text
  lat         Float?
  lng         Float?
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  ordersAsDestination Order[] @relation("DeliveryAddress")

  @@index([userId])
  @@index([city])
}

// سیستم امتیاز — تاریخچه تغییرات
model ScoreHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      // می‌تونه منفی هم باشه
  reason    String   // مثلا "purchase", "review_on_time", "referral", "violation"
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ════════════════════════════════════════════════════
// CITIES & SHIPPING (مدیریت ادمین)
// ════════════════════════════════════════════════════

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  shops             Shop[]
  picks             Pick[]
  carrierServices   CarrierService[]
  boxFilters        BoxFilter[]
  orders            Order[]

  @@index([name])
}

// سرویس‌های حمل خارج‌شهر — تعریف ادمین برای هر شهر
model CarrierService {
  id           String   @id @default(cuid())
  cityId       String
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name         String   // "پست ایران"، "الوپیک"، "تیپاکس"
  estimatedDays String  // "۳-۵ روز کاری"
  isActive     Boolean  @default(true)
  // آدرس/مکان دفتر این سرویس در این شهر (برای پیک منتخب)
  officeAddress String? @db.Text
  officeLat    Float?
  officeLng    Float?
  createdAt    DateTime @default(now())

  shipments    Shipment[]

  @@index([cityId])
}

// ════════════════════════════════════════════════════
// SHOP
// ════════════════════════════════════════════════════

model Shop {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopName        String
  shopType        String     // نوع فروشگاه
  nationalId      String     // کد ملی مدیر
  cityId          String
  city            City       @relation(fields: [cityId], references: [id])
  addressDetail   String     @db.Text
  lat             Float?
  lng             Float?

  licenseFileUrl  String?    // مجوز فروشگاه
  bannerFileUrl   String?    // بنر/تصویر (AI compress شده، حداکثر 10MB قبل فشرده‌سازی)

  status          ShopStatus @default(PENDING_REVIEW)
  reviewedAt      DateTime?
  reviewedBy      String?    // adminProfile id

  // کمیسیون‌ها — قابل تغییر، نیاز به تأیید فروشگاه
  productCommission Decimal  @default(7)  @db.Decimal(5,2)  // پیش‌فرض ۷٪
  boxCommission     Decimal  @default(20) @db.Decimal(5,2)  // پیش‌فرض ۲۰٪
  pendingCommissionChange Json? // {productCommission, boxCommission, requiresApproval: true}

  rating          Float      @default(0)
  totalSales      Decimal    @default(0) @db.Decimal(14,2)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products        Product[]
  boxes           Box[]
  orderItems      OrderItem[]
  wallet          Wallet?
  campaignOptIns  ShopCampaign[]
  // فروشگاه‌هایی که DiGiFACE box دارند (منتخب)
  isSelectedForBoxes Boolean @default(false)

  @@index([cityId])
  @@index([status])
}

// ════════════════════════════════════════════════════
// PRODUCTS
// ════════════════════════════════════════════════════

model Product {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name          String
  description   String?        @db.Text
  category      String         // مراقبت پوست، آرایشی، مو و ناخن، عطر...
  price         Decimal        @db.Decimal(12,2)
  imageUrl      String?
  videoUrl      String?

  packageSize   PackageSize    @default(SMALL) // تخمین AI برای حمل

  status        ProductStatus  @default(PENDING_AI)
  aiCheckNote   String?        @db.Text  // دلیل رد AI
  aiCheckedAt   DateTime?

  // ویرایش در صف — اگر تغییر جدید بیاد، قبلی از صف حذف می‌شه
  pendingEdit   Json?          // payload تغییرات در انتظار تأیید
  pendingEditAt DateTime?

  // اگر کاربر اصرار به اعمال تغییر رد‌شده داشت
  forceEditRequested Boolean   @default(false)
  forceEditNote String?        @db.Text

  isInStock     Boolean        @default(true) // false = محو خودکار

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orderItems    OrderItemProduct[]
  boxItems      BoxItem[]

  @@index([shopId])
  @@index([status])
  @@index([category])
}

// ════════════════════════════════════════════════════
// BOXES (شامل باکس بین‌فروشگاهی)
// ════════════════════════════════════════════════════

model Box {
  id              String     @id @default(cuid())
  shopId          String     // فروشگاه مالک باکس
  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name            String
  description     String?    @db.Text
  imageUrl        String?

  originalPrice   Decimal    @db.Decimal(12,2)
  discountedPrice Decimal    @db.Decimal(12,2)
  discountPercent Decimal    @db.Decimal(5,2)

  commission      Decimal    @default(20) @db.Decimal(5,2)
  status          BoxStatus  @default(ACTIVE)

  // آیا این باکس به عنوان "DiGiFACE Box" در فروشگاه‌های دیگر هم قابل سفارش است
  // (باکس بین‌فروشگاهی - فاز ۱)
  isInterShopEnabled Boolean @default(false)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items           BoxItem[]
  orderItems      OrderItem[]

  @@index([shopId])
  @@index([status])
}

model BoxItem {
  id        String   @id @default(cuid())
  boxId     String
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)

  // اگر از محصولات موجود فروشگاه باشه
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // اگر محصول فقط مخصوص باکس باشه (نیاز به تأیید ادمین)
  customName  String?
  customPrice Decimal? @db.Decimal(12,2)
  customNote  String?  @db.Text
  needsAdminApproval Boolean @default(false)
  approvedByAdmin    Boolean @default(false)

  quantity  Int      @default(1)

  @@index([boxId])
}

// فیلترهای باکس — تعریف ادمین برای هر شهر (اندازه، تنوع و...)
model BoxFilter {
  id          String   @id @default(cuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  name        String   // مثلا "حداکثر ۵ قلم"، "برند ایرانی"، "اندازه کوچک"
  filterType  String   // "size", "brand_origin", "item_count", "category"
  value       String   // مقدار فیلتر
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([cityId])
}

// ════════════════════════════════════════════════════
// CAMPAIGNS
// ════════════════════════════════════════════════════

model Campaign {
  id              String         @id @default(cuid())
  title           String
  description     String?        @db.Text
  discountPercent Decimal        @db.Decimal(5,2)
  commissionPercent Decimal      @db.Decimal(5,2) // کمیسیون ویژه کمپین

  startsAt        DateTime
  endsAt          DateTime
  status          CampaignStatus @default(DRAFT)

  // پیام آموزشی قبل از باز شدن صفحه پذیرش
  introMessage    String?        @db.Text

  createdAt       DateTime       @default(now())

  shopOptIns      ShopCampaign[]

  @@index([status])
}

model ShopCampaign {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  accepted    Boolean  @default(false)
  acceptedAt  DateTime?

  // فروشنده انتخاب می‌کند: همه محصولات یا بخشی
  appliesToAll Boolean @default(true)
  selectedProductIds Json? // آرایه شناسه محصولات منتخب

  createdAt   DateTime @default(now())

  @@unique([campaignId, shopId])
  @@index([shopId])
}

// ════════════════════════════════════════════════════
// PICK (DELIVERY PERSON)
// ════════════════════════════════════════════════════

model Pick {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  nationalId      String
  addressDetail   String     @db.Text
  cityId          String
  city            City       @relation(fields: [cityId], references: [id])

  vehicleType     String     // "motorcycle" | "car"
  vehicleDocUrl   String?    // مدارک خودرو/موتور
  licenseDocUrl   String?    // گواهینامه

  status          ShopStatus @default(PENDING_REVIEW) // همان enum فروشگاه قابل استفاده
  reviewedAt      DateTime?

  // کمیسیون پلتفرم از پیک — پیش‌فرض ۱۶٪، نیاز به تأیید پیک برای تغییر
  commission      Decimal    @default(16) @db.Decimal(5,2)
  pendingCommissionChange Decimal? @db.Decimal(5,2)
  commissionApproved Boolean @default(true)

  // پیک منتخب برای سفارشات خارج‌شهر
  isSelectedForIntercity Boolean @default(false)
  // پیک منتخب برای کارهای چکی کاربر ویژه (فاز ۲)
  isSelectedForChecks    Boolean @default(false)

  rating          Float      @default(0)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  wallet          Wallet?
  deliveries      Order[]    @relation("PickDeliveries")
  reports         ViolationReport[]

  @@index([cityId])
  @@index([status])
}

// ════════════════════════════════════════════════════
// ORDERS
// ════════════════════════════════════════════════════

model Order {
  id              String        @id @default(cuid())
  orderCode       String        @unique // کد سفارش — برای تطبیق پیک/فروشگاه

  customerId      String
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id])

  addressId       String
  address         Address       @relation("DeliveryAddress", fields: [addressId], references: [id])

  cityId          String        // شهر مقصد
  city            City          @relation(fields: [cityId], references: [id])

  type            OrderType     @default(LOCAL)
  status          OrderStatus   @default(PENDING_SHOP)

  subtotal        Decimal       @db.Decimal(12,2)
  shippingCost    Decimal       @db.Decimal(12,2) @default(0)
  total           Decimal       @db.Decimal(12,2)

  paymentMethod   PaymentMethod @default(ONLINE)
  isPaid          Boolean       @default(false)
  paidAt          DateTime?

  // ── تایمرهای فروشگاه ──
  // ۷ ساعت برای تأیید — اگر گذشت به ادمین
  shopAcceptDeadline DateTime?
  shopAcceptedAt     DateTime?

  // ── لغو/رد جزئی ──
  cancelReason       String?    @db.Text
  cancelledItemsNote String?    @db.Text // اقلام موجود که فروشنده می‌تونه پر کنه

  // ── پیک ──
  pickId          String?
  pick            Pick?         @relation("PickDeliveries", fields: [pickId], references: [id])
  pickAcceptDeadline DateTime?  // ۴ ساعت برای قبول پیک
  pickPickedUpAt  DateTime?
  pickDeliverDeadline DateTime? // ۳ ساعت برای تحویل دادن بعد از تحویل گرفتن
  pickDeliveredAt DateTime?

  // ارتباط مشتری-پیک: امن (پلتفرم) یا مستقیم — انتخاب مشتری
  pickContactMode String?      @default("secure") // "secure" | "direct"

  // ── ارزیابی مشتری ──
  // ۷ ساعت همشهری (متوقف ۷شب-۸صبح) / ۹۶ ساعت خارج‌شهر
  reviewDeadline  DateTime?
  reviewedAt      DateTime?

  // ── پشتیبانی سفارش ── ۱ هفته از ثبت
  supportDeadline DateTime?

  // عودت توسط پیک
  isReturned      Boolean       @default(false)
  returnedAt      DateTime?

  // یادداشت‌های سیستمی/AI برای پردازش خودکار خارج‌شهر
  intercityAiNote String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  review          Review?
  shipment        Shipment?
  transactions    Transaction[]
  notifications   Notification[]

  @@index([customerId])
  @@index([status])
  @@index([pickId])
  @@index([cityId])
  @@index([orderCode])
}

// آیتم‌های سفارش — می‌تونه محصول تکی یا باکس باشه
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shopId    String   // فروشگاهی که این آیتم را تأمین می‌کند
  shop      Shop     @relation(fields: [shopId], references: [id])

  boxId     String?
  box       Box?     @relation(fields: [boxId], references: [id])

  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12,2)

  // وضعیت تأیید توسط این فروشگاه (برای سفارشاتی که چند فروشگاه دارند)
  isConfirmed Boolean @default(false)
  isAvailable Boolean @default(true) // false = در رد جزئی حذف شد

  // باکس بین‌فروشگاهی: اگر این آیتم از فروشگاه دیگری تأمین شده
  isInterShopFulfillment Boolean @default(false)
  fulfillingShopId       String? // فروشگاهی که واقعاً کالا را داد

  products  OrderItemProduct[]

  @@index([orderId])
  @@index([shopId])
}

// محصولات داخل هر آیتم سفارش (برای باکس‌ها که چند محصول دارند)
model OrderItemProduct {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int       @default(1)

  @@index([orderItemId])
}

// ════════════════════════════════════════════════════
// SHIPMENT (ارسال خارج‌شهر)
// ════════════════════════════════════════════════════

model Shipment {
  id              String          @id @default(cuid())
  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method          DeliveryMethod
  packageSize     PackageSize     @default(SMALL)

  carrierServiceId String?
  carrierService    CarrierService? @relation(fields: [carrierServiceId], references: [id])

  // محاسبه هزینه: هزینه پست محلی × ۱.۳ + هزینه پلتفرم بین‌شهری
  localPostCost   Decimal?        @db.Decimal(12,2)
  platformFee     Decimal?        @db.Decimal(12,2)
  totalCost       Decimal?        @db.Decimal(12,2)

  // پردازش خودکار AI برای خارج‌شهر
  processedByAi   Boolean         @default(false)
  aiProcessedAt   DateTime?

  trackingCode    String?
  paymentLinkSent Boolean         @default(false)
  paymentLinkSentAt DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
}

// ════════════════════════════════════════════════════
// REVIEWS
// ════════════════════════════════════════════════════

model Review {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])

  type        ReviewType
  reportReason ReportReason?
  comment     String?       @db.Text

  // اگر گزارش بود — بررسی ادمین ظرف ۲۴ ساعت
  adminReviewed   Boolean   @default(false)
  adminReviewedAt DateTime?
  adminNote       String?   @db.Text

  // اگر سیستم نتونست خودکار جمع‌بندی کنه، تماس کارشناس + ضبط
  callRecordingUrl String?
  resolvedByCall    Boolean @default(false)

  createdAt   DateTime      @default(now())

  @@index([userId])
}

// گزارش تخلف (پیک/مشتری)
model ViolationReport {
  id          String    @id @default(cuid())
  pickId      String?
  pick        Pick?     @relation(fields: [pickId], references: [id])

  reportedByUserId String
  reason      ReportReason
  description String?   @db.Text

  reviewed    Boolean   @default(false)
  reviewedAt  DateTime?
  resolution  String?   @db.Text

  createdAt   DateTime  @default(now())

  @@index([pickId])
}

// ════════════════════════════════════════════════════
// WALLET & TRANSACTIONS
// ════════════════════════════════════════════════════

model Wallet {
  id            String          @id @default(cuid())
  ownerType     WalletOwnerType

  userId        String?         @unique
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopId        String?         @unique
  shop          Shop?           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  pickId        String?         @unique
  pick          Pick?           @relation(fields: [pickId], references: [id], onDelete: Cascade)

  balance       Decimal         @default(0) @db.Decimal(14,2)

  // برای پیک: خالص/ناخالص
  grossEarnings Decimal         @default(0) @db.Decimal(14,2)

  // اطلاعات حساب بانکی برای تسویه — تغییر با تأیید دو مرحله‌ای
  bankCardNumber String?
  bankSheba      String?
  bankAccountName String?
  pendingBankChange Json?       // در انتظار 2FA

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions  Transaction[]
  withdrawalRequests WithdrawalRequest[]
}

model Transaction {
  id          String           @id @default(cuid())
  walletId    String
  wallet      Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)

  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id])

  type        TransactionType
  amount      Decimal          @db.Decimal(14,2) // می‌تونه منفی باشه
  description String?

  createdAt   DateTime         @default(now())

  @@index([walletId])
  @@index([orderId])
}

model WithdrawalRequest {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(14,2)
  status      String   @default("pending") // pending | approved | rejected | paid

  requestedAt DateTime @default(now())
  processedAt DateTime?

  @@index([walletId])
}

// ════════════════════════════════════════════════════
// SUPPORT TICKETS
// ════════════════════════════════════════════════════

model Ticket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // عنوان تولید‌شده توسط AI
  aiTitle     String
  category    TicketCategory @default(OTHER)

  status      TicketStatus   @default(ACTIVE)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    TicketMessage[]

  @@index([userId])
  @@index([category])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderRole Role    // کی فرستاده (CUSTOMER/SHOP/PICK/ADMIN)
  senderId   String
  message    String  @db.Text
  attachmentUrl String?

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ════════════════════════════════════════════════════
// ADMIN
// ════════════════════════════════════════════════════

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // دسترسی‌های تعریف‌شده توسط مدیر اصلی (JSON برای انعطاف)
  permissions Json     // {"shops": true, "picks": true, "finance": false, ...}

  isSuperAdmin Boolean @default(false)

  createdAt   DateTime @default(now())

  auditLogs   AuditLog[]
}

// ثبت تمام فعالیت‌های ادمین (نکته امنیتی)
model AuditLog {
  id          String       @id @default(cuid())
  adminId     String
  admin       AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  action      String       // مثلا "approve_shop", "reject_pick", "edit_commission"
  targetType  String       // "Shop", "Pick", "Order", ...
  targetId    String
  details     Json?

  createdAt   DateTime     @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

// ════════════════════════════════════════════════════
// NOTIFICATIONS
// ════════════════════════════════════════════════════

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id])

  title     String
  message   String              @db.Text
  channel   NotificationChannel @default(IN_APP)

  isRead    Boolean             @default(false)
  sentAt    DateTime?           // برای SMS که async ارسال می‌شه

  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([orderId])
}

// ════════════════════════════════════════════════════
// BIG DATA — رفتار کاربران
// ════════════════════════════════════════════════════

model BehaviorLog {
  id        String   @id @default(cuid())
  userId    String?  // null برای بازدیدکننده مهمان
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionId String   // شناسه session مهمان/کاربر
  eventType String   // "search", "view_product", "add_to_cart", "view_shop", "chat", ...
  eventData Json?    // جزئیات رویداد

  cityId    String?
  ip        String?
  userAgent String?  @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([sessionId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════
// AI PROCESSING LOG — لاگ تصمیمات هوش مصنوعی
// ════════════════════════════════════════════════════

model AiLog {
  id          String   @id @default(cuid())
  module      String   // "product_check", "ticket_categorize", "package_size", "intercity_shipment", "file_compress"
  targetType  String   // "Product", "Ticket", "Order", ...
  targetId    String

  input       Json?
  output      Json?
  decision    String?  // "approved", "rejected", "needs_admin", ...

  createdAt   DateTime @default(now())

  @@index([module])
  @@index([targetType, targetId])
}
